# Copy to .env (git-ignored). All optional: the engine runs offline without keys.
DRY_RUN=true
AUTO_PUBLISH=false

# TikTok for Developers app (Content Posting API + Display API). OAuth 2.0 + PKCE; the engine never asks for your password.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8765/callback

# Cross-posting (YouTube Shorts via the studio engine)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional providers
ANTHROPIC_API_KEY=
TTS_API_KEY=
ELEVENLABS_VOICE_ID=
RESEARCH_API_KEY=
STUDIO_CONTACT_EMAIL=
TIKTOK_HOME=
