# Secrets — never commit
.env
.env.*
!.env.example
secrets/
*client_secret*.json
*token*.json
credentials/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Generated workspace data (keep the folders, not the contents)
database/*
research/*
sources/*
licenses/*
scripts/*
audio/*
visuals/*
captions/*
projects/*
renders/*
thumbnails/*
exports/*
analytics/*
logs/*
!*/.gitkeep

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# TikTok engine: models and generated workspace data
tiktok-engine/models/
tiktok-engine/database/*
tiktok-engine/research/*
tiktok-engine/trends/*
tiktok-engine/sources/*
tiktok-engine/licenses/*
tiktok-engine/scripts/*
tiktok-engine/audio/*
tiktok-engine/visuals/*
tiktok-engine/storyboards/*
tiktok-engine/captions/*
tiktok-engine/projects/*
tiktok-engine/renders/*
tiktok-engine/exports/*
tiktok-engine/thumbnails/*
tiktok-engine/analytics/*
tiktok-engine/logs/*
!tiktok-engine/*/.gitkeep
