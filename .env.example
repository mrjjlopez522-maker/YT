# Copy to .env and fill in. Never commit .env.
# Every value is optional: without keys the studio runs fully offline
# (local research notes, local source library, espeak-ng voice, offline writer).

# --- Safety switches (these defaults are also enforced in code) ---
DRY_RUN=true
AUTO_PUBLISH=false

# --- YouTube (official Data API v3 / Analytics API v2, OAuth installed-app flow) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional API key for read-only calls (trends: mostPopular chart, niche competition counts)
YOUTUBE_API_KEY=

# --- LLM (optional; enables the Anthropic script writer) ---
ANTHROPIC_API_KEY=

# --- TTS (optional; enables the ElevenLabs provider) ---
TTS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Polite API identification (sent in User-Agent to Wikimedia etc.) ---
STUDIO_CONTACT_EMAIL=

# --- Workspace root (defaults to the repository directory) ---
STUDIO_HOME=
