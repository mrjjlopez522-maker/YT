# People — environment variables. Placeholders only; never commit real values.
# With nothing set, the app runs in clearly labelled DEMO MODE with local fixtures.

# ── Supabase (accounts, Postgres, realtime). All three are needed for live mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only Postgres connection string (Supabase → Connect → "Session pooler" or direct).
# Never prefix with NEXT_PUBLIC_. Leave out "sslmode" when DATABASE_CA_CERT is set.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres
# PEM text of Supabase's root certificate (Database settings → SSL) for verified TLS. "\n" escapes are OK.
DATABASE_CA_CERT=

# Only allow people you invited from the Supabase dashboard to sign in.
PEOPLE_INVITE_ONLY=true

# Force demo mode even if Supabase variables are present (useful for local UI work).
# PEOPLE_MODE=demo

# ── LiveKit (optional voice/video). Without these, sessions are text-only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# ── Optional AI-assisted topic suggestions (keyword matching is used otherwise).
ANTHROPIC_API_KEY=
# PEOPLE_AI=off
